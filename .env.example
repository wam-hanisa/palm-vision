# Copy this file to .env and fill in real values for local development.
# Defaults below are safe for local Docker Compose use only — never reuse
# SECRET_KEY or DB_PASSWORD in any deployed environment.

# --- Django core ---
DEBUG=True
SECRET_KEY=change-me-for-local-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=palmvision.settings.local

# --- Database (must match docker-compose.yml db service) ---
DB_NAME=palmvision
DB_USER=palmvision
DB_PASSWORD=palmvision
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- JWT (API auth for the offline PWA) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- File storage ---
# Leave blank for local dev to use Django's local filesystem storage.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# --- Imagery / ML pipeline (docs/06-ml-pipeline.md, Phase 5) ---
# Leave both blank to use the honest stub detector/classifier (no real
# model trained yet) — see apps/imagery/ml/*.py. Only set these once real
# trained weights exist.
DETECTION_MODEL_PATH=
CLASSIFICATION_MODEL_PATH=
TREE_MATCH_DEFAULT_THRESHOLD_M=3.0

# --- Email (notifications, docs/12-security-ops.md, Phase 7) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@palmvision.local

# --- Compliance (docs/07-compliance.md, Phase 6) ---
COMPLIANCE_EXPIRY_WARNING_DAYS=90
# Not yet integrated against any real deforestation-monitoring API — this
# var is a placeholder for that future integration (e.g. Global Forest
# Watch), not something apps/compliance currently reads. DeforestationBaseline
# rows are created/verified manually (via the API or admin) for now.
FOREST_MONITORING_API_KEY=

# --- Notifications (docs/12-security-ops.md § Alerting & notifications, Phase 7) ---
COMPLIANCE_NOTIFICATION_THRESHOLDS_DAYS=90,60,30
TREE_HEALTH_ANOMALY_WINDOW_DAYS=7
TREE_HEALTH_ANOMALY_MIN_INCREASE=5
STALLED_SYNC_DAYS=3
REVIEW_BACKLOG_THRESHOLD=20
APPROVAL_PENDING_DAYS=3
