# Copy this file to .env and fill in real values for local development.
# Defaults below are safe for local Docker Compose use only — never reuse
# SECRET_KEY or DB_PASSWORD in any deployed environment.

# --- Django core ---
DEBUG=True
SECRET_KEY=change-me-for-local-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=palmvision.settings.local

# --- Database (must match docker-compose.yml db service) ---
DB_NAME=palmvision
DB_USER=palmvision
DB_PASSWORD=palmvision
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- JWT (API auth for the offline PWA) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- File storage ---
# Leave blank for local dev to use Django's local filesystem storage.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# --- Imagery / ML pipeline (docs/06-ml-pipeline.md, Phase 5) ---
# Leave either blank to use the honest stub (no detections / always-low-
# confidence) — see apps/imagery/ml/*.py.
#
# Both real trained models now live in the sibling palm-vision-ml repo (the
# actual training project — trained there, not duplicated into this repo's
# git history) and are mounted read-only into the web/worker/beat
# containers at /ml_models by docker-compose.yml, from
# ../palm-vision-ml/tree_health_pipeline/trained_models on the host. These
# defaults work out of the box IF you have palm-vision-ml checked out as a
# sibling directory of this repo (i.e. both under the same parent folder).
# If you don't, comment out the `/ml_models` volume line in
# docker-compose.yml and leave both vars below blank.
#
# DETECTION_MODEL_PATH: Faster R-CNN (ResNet50-FPN-v2), single class
# ("oilpalm"), trained on the Roboflow "tree-detection" dataset — see
# apps/imagery/ml/detection.py's module docstring for the full provenance
# and validation metrics (precision 0.989, recall 0.961 on held-out data).
DETECTION_MODEL_PATH=/ml_models/crown_detector_run/checkpoints/tree-detection_fold0_checkpoint.pt
# CLASSIFICATION_MODEL_PATH: ResNet-18 (10-channel RGB+VI input), trained on
# the full Roboflow "Oil-Palm-Health" dataset — see apps/imagery/ml/
# classification.py's module docstring for the full provenance and its
# validation metrics.
CLASSIFICATION_MODEL_PATH=/ml_models/oil_palm_health_classifier.pth
# CLASSIFICATION_NORMALIZE_EXPOSURE: opt-in per-channel color-balance
# correction for a real domain-gap bug the ml-repo found between its
# training data and a specific customer's orthomosaic imagery — see
# apps/imagery/ml/classification.py's module docstring for the full
# writeup, including why this defaults to false (unconditionally applying
# it measurably regresses accuracy on in-distribution imagery). Only set
# this true after independently confirming (the way it was found) that
# YOUR deployment's imagery shows the same mismatch — do not copy `true`
# from another deployment's .env without that check.
CLASSIFICATION_NORMALIZE_EXPOSURE=false
TREE_MATCH_DEFAULT_THRESHOLD_M=3.0
CROWN_DETECTION_DEFAULT_IOU_THRESHOLD=0.3
DETECTION_DEFAULT_TARGET_GSD_M=0.06
IMAGE_PREVIEW_MAX_DIMENSION_PX=1024
# Cloud Optimized GeoTIFF re-encoding — see convert_to_cog() in
# apps/imagery/services.py.
IMAGE_COG_BLOCKSIZE=512
IMAGE_COG_COMPRESSION=DEFLATE

# --- Email (notifications, docs/12-security-ops.md, Phase 7) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@palmvision.local

# --- Compliance (docs/07-compliance.md, Phase 6) ---
COMPLIANCE_EXPIRY_WARNING_DAYS=90
# Not yet integrated against any real deforestation-monitoring API — this
# var is a placeholder for that future integration (e.g. Global Forest
# Watch), not something apps/compliance currently reads. DeforestationBaseline
# rows are created/verified manually (via the API or admin) for now.
FOREST_MONITORING_API_KEY=

# --- Notifications (docs/12-security-ops.md § Alerting & notifications, Phase 7) ---
COMPLIANCE_NOTIFICATION_THRESHOLDS_DAYS=90,60,30
TREE_HEALTH_ANOMALY_WINDOW_DAYS=7
TREE_HEALTH_ANOMALY_MIN_INCREASE=5
STALLED_SYNC_DAYS=3
REVIEW_BACKLOG_THRESHOLD=20
APPROVAL_PENDING_DAYS=3
NOTIFICATION_SNOOZE_DAYS=3
IMAGE_UPLOAD_CHUNK_SIZE_BYTES=8388608

# Django's default (1000) is too low for this app's own large-table admin
# pages (e.g. /admin/trees/treecarerecord/ — see palmvision/settings/base.py
# for why). Staff-only admin, so raising this doesn't weaken DoS protection
# anywhere a stranger could reach it.
DATA_UPLOAD_MAX_NUMBER_FIELDS=10000

# --- Image storage lifecycle (docs/12-security-ops.md § Image storage
# lifecycle & cost policy, Phase 6) — see apply_storage_lifecycle() in
# apps/imagery/services.py for what this does (and doesn't) actually do
# without a production object storage backend configured. ---
IMAGE_STORAGE_COLD_TIER_DAYS=90
